@model WeeklyMansion.Models.Property

<h2>物件詳細</h2>

<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <td>@Model.PropertyId</td>
    </tr>
    <tr>
        <th>物件名</th>
        <td>@Model.PropertyName</td>
    </tr>
    <tr>
        <th>住所</th>
        <td>@Model.Address</td>
    </tr>
</table>

<a asp-action="Edit"
   asp-route-id="@Model.PropertyId"
   class="btn btn-primary">
    編集
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    戻る
</a>
