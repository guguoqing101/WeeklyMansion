@model WeeklyMansion.Models.Room

@{
    ViewData["Title"] = "Edit";
}

<h1>編集</h1>

<h4>部屋データ</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="RoomId" />
            <input type="hidden" asp-for="PropertyId" />
            <div class="form-group">
                物件ID
                <input value="@Model.PropertyId" class="form-control" readonly />
                <span asp-validation-for="PropertyId" class="text-danger"></span>
            </div>
            <div class="form-group">
                部屋No
                <input asp-for="RoomNo" class="form-control" />
                <span asp-validation-for="RoomNo" class="text-danger"></span>
            </div>
            <div class="form-group">
                部屋名
                <input asp-for="RoomName" class="form-control" />
                <span asp-validation-for="RoomName" class="text-danger"></span>
            </div>
            <div class="form-group">
                定員
                <input asp-for="Capacity" class="form-control" type="number" min="1" max="10" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>
            <div class="form-group">
                利用状態
                <select asp-for="IsActive" class="form-select">
                    <option value="true">利用可能</option>
                    <option value="false">利用停止</option>
                </select>
                <span asp-validation-for="IsActive" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="更新" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" asp-route-propertyId="@Model?.PropertyId">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
